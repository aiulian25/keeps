# Keeps. Copy this to .env next to docker-compose.yml, then run: chmod 600 .env
# Fill in the setting under "Required". Everything else is optional: uncomment what you want to change.
# The household, currency, theme, sign-in methods and backups are set in the app.

# --- Required ---------------------------------------------------------------------------------------------------------

# The HTTPS address you open Keeps at, without a trailing slash. Passkeys belong to this hostname: changing it later
# means adding them again. A plain http:// or IP address won't work: browsers only allow sign-in on secure addresses.
APP_ORIGIN=https://keeps.example.com

# --- Publishing -------------------------------------------------------------------------------------------------------

# The address port 6030 is published on. 127.0.0.1 keeps it to this machine, for a proxy running here. Use this
# machine's LAN address when the proxy is elsewhere or in a container.
# KEEPS_BIND_ADDRESS=127.0.0.1
# The port on this machine your proxy forwards to.
# KEEPS_PORT=6030
# Your reverse proxy's addresses or CIDR ranges, comma separated, so it may pass the visitor's address on (for
# sign-in rate limits and the logs). Leave unset when nothing sits in front of Keeps.
# KEEPS_TRUSTED_PROXIES=
